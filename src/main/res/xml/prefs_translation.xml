<!--
	The language lists are populated in SettingsFragment, using language names
	from java.util.Locale.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

	<CheckBoxPreference
			android:title="@string/pref_translation_enabled_title"
			android:key="@string/pref_translation_enabled_key"
			android:summary="@string/pref_translation_enabled_summary"
			android:defaultValue="false"/>

	<ListPreference
			android:title="@string/pref_translation_primary_language_title"
			android:key="@string/pref_translation_primary_language_key"
			android:dialogTitle="@string/pref_translation_primary_language_title"
			android:defaultValue="auto"/>

	<MultiSelectListPreference
			android:title="@string/pref_translation_secondary_languages_title"
			android:key="@string/pref_translation_secondary_languages_key"
			android:dialogTitle="@string/pref_translation_secondary_languages_title"/>

	<MultiSelectListPreference
			android:title="@string/pref_translation_content_title"
			android:key="@string/pref_translation_content_key"
			android:dialogTitle="@string/pref_translation_content_title"
			android:entries="@array/pref_translation_content"
			android:entryValues="@array/pref_translation_content_return"
			android:defaultValue="@array/pref_translation_content_return"/>

	<CheckBoxPreference
			android:title="@string/pref_translation_wifi_only_title"
			android:key="@string/pref_translation_wifi_only_key"
			android:defaultValue="true"/>

	<Preference
			android:title="@string/pref_translation_models_title"
			android:key="@string/pref_translation_models_key"
			android:summary="@string/pref_translation_models_summary"/>

	<CheckBoxPreference
			android:title="@string/pref_translation_debug_fake_backend_title"
			android:key="@string/pref_translation_debug_fake_backend_key"
			android:defaultValue="false"/>

</PreferenceScreen>
